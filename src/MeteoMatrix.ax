# @name MeteoMatrix
# @desc Weather, air quality, pollen and Sun/Moon for any location
# @version 0.2.0-dev
# @author sp7uto
# @config latitude number "Latitude" default=51.590748 min=-90 max=90 step=0.000001
# @config longitude number "Longitude" default=18.736974 min=-180 max=180 step=0.000001
# @config timezone text "Timezone (IANA)" default="Europe/Warsaw"
# @config language select "Language / Jezyk" options=pl,en default=pl
# @display 32x8
import json
class MeteoMatrix
  var wurl, aurl, purl, weather, air, pollen, daily
  var labels, colors, page, glyphs
  var ticks, busy, weather_at, air_at, pollen_at, scroll_opts
  var temp_fill, feels_fill, phase, anim_start, language
  def init()
 self.language = store.get("language")
 var lat = str(store.get("latitude"))
 var lon = str(store.get("longitude"))
 var tz = str(store.get("timezone"))
 var coords = "latitude=" + lat + "&longitude=" + lon
 self.wurl = "https://api.open-meteo.com/v1/forecast?" + coords +
   "&current=temperature_2m,apparent_temperature,precipitation,snowfall,weather_code,cloud_cover,shortwave_radiation,pressure_msl,wind_speed_10m,wind_gusts_10m,soil_temperature_6cm" +
   "&daily=daylight_duration,temperature_2m_min,sunrise,sunset,moonrise,moonset,moon_phase&forecast_days=2" +
   "&temperature_unit=celsius&wind_speed_unit=kmh&precipitation_unit=mm&timezone=" + tz
 self.aurl = "https://air-quality-api.open-meteo.com/v1/air-quality?" + coords +
   "&current=european_aqi,pm2_5,pm10&domains=cams_europe"
 self.purl = "https://air-quality-api.open-meteo.com/v1/air-quality?" + coords +
   "&current=alder_pollen,birch_pollen,grass_pollen,mugwort_pollen,ragweed_pollen&domains=cams_europe"
 self.weather = nil
 self.air = nil
 self.pollen = nil
 self.daily = nil
 self.page = 0
 self.ticks = 0
 self.busy = false
 self.weather_at = 0
 self.air_at = 0
 self.pollen_at = 0
 self.temp_fill = 0x0088FF
 self.feels_fill = 0x0088FF
 self.phase = nil
 self.anim_start = now_ms()
 self.scroll_opts = {"mode":"wrap", "repeat":1, "speed":100, "whenFits":"static"}
 self.labels = [
   "T --°C", self.tr("OD --°C","FEELS --°C")__REPLACE_END__ --°C", self.tr("DESZCZ -- mm","RAIN -- mm")__REPLACE_END__ -- mm", self.tr("CH --%","CLOUD --%")__REPLACE_END__ --%",
   self.tr("SL -- W/m2","SUN -- W/m2")__REPLACE_END__ -- W/m2", "P -- hPa", self.tr("W -- km/h","WIND -- km/h")__REPLACE_END__ -- km/h", self.tr("G -- km/h","GUST -- km/h")__REPLACE_END__ -- km/h",
   "EAQI --", "PM2.5 -- ug/m3", "PM10 -- ug/m3",
   self.tr("GL --°C","SOIL --°C")__REPLACE_END__ --°C", self.tr("DZIEN --","DAY --")__REPLACE_END__ --", self.tr("PRZYM --°C","FROST --°C")__REPLACE_END__ --°C",
   self.tr("OLCHA -- zi/m3","ALDER -- zi/m3")__REPLACE_END__ -- zi/m3", self.tr("BRZOZA -- zi/m3","BIRCH -- zi/m3")__REPLACE_END__ -- zi/m3", self.tr("TRAWY -- zi/m3","GRASS -- zi/m3")__REPLACE_END__ -- zi/m3",
   self.tr("BYLICA -- zi/m3","MUGWORT -- zi/m3")__REPLACE_END__ -- zi/m3", self.tr("AMBROZJA -- zi/m3","RAGWEED -- zi/m3")__REPLACE_END__ -- zi/m3",
   self.tr("SNIEG -- cm","SNOW -- cm")__REPLACE_END__ -- cm", self.tr("GRAD","HAIL"), self.tr("WSCH SL --:--","SUNRISE --:--")__REPLACE_END__ --:--", self.tr("ZACH SL --:--","SUNSET --:--")__REPLACE_END__ --:--",
   self.tr("WSCH KS --:--","MOONRISE --:--")__REPLACE_END__ --:--", self.tr("ZACH KS --:--","MOONSET --:--")__REPLACE_END__ --:--", self.tr("FAZA --","PHASE --")__REPLACE_END__ --"
 ]
 self.colors = [
   0x00D5FF, 0x66BBFF, 0x3388FF, 0xBBBBBB,
   0xFFCC00, 0xFFFFFF, 0x66DDFF, 0xFFAA44,
   0x00DD66, 0x44DDBB, 0xFFCC44,
   0x99DD66, 0xFFDD55, 0x77BBFF,
   0x88DD33, 0x88DD33, 0x88DD33, 0xFFCC44, 0xFFCC44,
   0xBBEEFF, 0xFFFFFF, 0xFFCF32, 0xFF952A,
   0xE8F2FF, 0xAACCEE, 0xE8F2FF
 ]
 self.glyphs = [
   ["..WWW...","..WTW...","..WTW...","..WTW...","..WTW...",".WTTTW..",".WTTTW..","..WWW..."],
   [".WW.WWW.",".WCW.WTW",".WWW.WTW","..W..WTW",".WWW.WTW","WCCCWTW.","WCCCWTW.","WCCCWWW."],
   ["...B....","..BBB...","..BCB...",".BBCBB..",".BBCBBB.","BBBCBBB.",".BBBBB..","..BBB..."],
   ["........","...SS...","..SWWSS.",".SWWWWS.","SWWWWWW.","WWWWWWWW",".SWWWS..","..SSS..."],
   ["...Y....",".Y.Y..Y.","..OYYO..","Y.OYYO.Y","Y.OYYO.Y","..OYYO..",".Y.Y..Y.","...Y...."],
   ["..GGYYO.",".G....O.","G......R","G..W..RR","Y...W.R.",".Y...R..","..ORRR..","........"],
   ["........","...CCC..","..C...C.","CCCCCCC.","......C.",".CCCCC..",".....C..","..CCC..."],
   ["...OOO..","..O...O.","YYYYYOO.",".....OO.","OOOOOOO.","......O.",".OOOOO..","........"],
   ["......RR","......RR","....OORR","....OORR","..YYOORR","..YYOORR","GGYYOORR","GGYYOORR"],
   ["........","..G...Y.","....C...","G..Y...C","...G....",".C...Y..","....G...",".Y...C.."],
   ["........",".YY...RR",".YY...RR","........","...OO...","...OO...",".GG.....",".GG....."],
   ["........","..G.G...","..GGG...","...G....",".DDGDD..","DDDGDDDD","DDDDDDDD","DDDDDDDD"],
   ["...Y....",".Y.Y..Y.","..OYYO..","Y.OYYO.Y","Y.OYYO.Y","..OYYO..","CCCCCCCC","........"],
   ["..WWW...","..WBW...","..WBW.C.","..WBWCCC","..WBW.C.",".WBBBW..",".WBBBW..","..WWW..."],
   [".....Y..","...G.Y..","..GGGG..",".GGGGG.Y","..DDGG..","..DDY...","..DD....","..DD...."],
   [".....W.Y","..GGG.W.",".GGGGGY.","GGGGGG..","..DDGG.Y","..DDY...","..DD....","..DD...."],
   ["..Y...Y.","...G..Y.","..GG.G..",".GGG.G.Y","GGGGGG..",".GGGGG..","..GGG...","........"],
   ["...Y.Y..","..G.Y.Y.",".GGG.G..","GGGGGG..","..GGGG..","...GG...","..GG....","........"],
   [".Y..Y...","..G.GY..","..G.YG..","..GGG...",".GGGGG..","..GGG...","...GG...","........"],
   ["...W....",".C.W.C..","..CWC...","WWWCWWWW","..CWC...",".C.W.C..","...W....","........"],
   ["...SS...","..SWWWS.",".SWWWWWS","SSWWWWSS","........",".W...W..","..WCW...",".C...C.."]
 ]
  end
  def tr(pl, en)
 return self.language == "en" ? en : pl
  end
  def n0(v)
 if v == nil return "--" end
 var half = v >= 0 ? 0.5 : -0.5
 return str(int(v + half))
  end
  def n1(v)
 if v == nil return "--" end
 return format("%.1f", v)
  end
  def temp_color(v)
 if v == nil return 0x888888 end
 if v <= 0 return 0x1268FF end
 if v <= 5 return 0x18C9FF end
 if v <= 15 return 0x39DD38 end
 if v <= 20 return 0xFFDD22 end
 if v <= 25 return 0xFF9922 end
 return 0xFF3333
  end
  def weather_code()
 if self.weather == nil return nil end
 return self.weather.find("weather_code")
  end
  def positive(v, threshold)
 return v != nil && v >= threshold
  end
  def is_snow()
 if self.weather == nil return false end
 var snow = self.weather.find("snowfall")
 if self.positive(snow, 0.05) return true end
 var c = self.weather_code()
 var p = self.weather.find("precipitation")
 return self.positive(p, 0.05) && c != nil &&
   (c == 71 || c == 73 || c == 75 || c == 77 || c == 85 || c == 86)
  end
  def is_hail()
 if self.weather == nil return false end
 var c = self.weather_code()
 var p = self.weather.find("precipitation")
 return self.positive(p, 0.05) && c != nil && (c == 96 || c == 99)
  end
  def build_weather()
 var w = self.weather
 if w == nil return end
 var t = w.find("temperature_2m")
 var f = w.find("apparent_temperature")
 self.temp_fill = self.temp_color(t)
 self.feels_fill = self.temp_color(f)
 self.colors[0] = self.temp_fill
 self.colors[1] = self.feels_fill
 self.labels[0] = "T " + self.n0(t) + "°C"
 self.labels[1] = self.tr("OD ","FEELS ")__REPLACE_END__ " + self.n0(f) + "°C"
 self.labels[2] = self.tr("DESZCZ ","RAIN ")__REPLACE_END__ " + self.n1(w.find("precipitation")) + " mm"
 self.labels[3] = self.tr("CH ","CLOUD ")__REPLACE_END__ " + self.n0(w.find("cloud_cover")) + "%"
 self.labels[4] = self.tr("SL ","SUN ")__REPLACE_END__ " + self.n0(w.find("shortwave_radiation")) + " W/m2"
 self.labels[5] = "P " + self.n0(w.find("pressure_msl")) + " hPa"
 self.labels[6] = self.tr("W ","WIND ")__REPLACE_END__ " + self.n0(w.find("wind_speed_10m")) + " km/h"
 self.labels[7] = self.tr("G ","GUST ")__REPLACE_END__ " + self.n0(w.find("wind_gusts_10m")) + " km/h"
 self.labels[11] = self.tr("GL ","SOIL ")__REPLACE_END__ " + self.n0(w.find("soil_temperature_6cm")) + "°C"
 var snow = w.find("snowfall")
 if self.positive(snow, 0.05)
   self.labels[19] = self.tr("SNIEG ","SNOW ")__REPLACE_END__ " + self.n1(snow) + " cm"
 else
   self.labels[19] = self.tr("SNIEG","SNOW")
 end
 if self.is_hail()
   self.labels[20] = self.tr("GRAD","HAIL")
 end
  end
  def clock_hm(v)
 if v == nil return nil end
 var m = re.search("T([0-9][0-9]:[0-9][0-9])", str(v))
 if m == nil return nil end
 return m[1]
  end
  def build_daily()
 var d = self.daily
 if d == nil return end
 var mp = d.find("moon_phase")
 if mp != nil && size(mp) > 0
   self.phase = mp[0]
   if self.phase != nil
     var p = self.phase
     var f = self.tr("NOW","NEW")
     if p >= 0.94 || p < 0.06
       f = self.tr("NOW","NEW")
     elif p < 0.19
       f = self.tr("SIERP +","WAX CRES")
     elif p < 0.31
       f = self.tr("I KWADRA","1ST QTR")
     elif p < 0.44
       f = self.tr("GARB +","WAX GIBB")
     elif p < 0.56
       f = self.tr("PELNIA","FULL")
     elif p < 0.69
       f = self.tr("GARB -","WAN GIBB")
     elif p < 0.81
       f = self.tr("III KWADRA","3RD QTR")
     else
       f = self.tr("SIERP -","WAN CRES")
     end
     self.labels[25] = self.tr("FAZA ","PHASE ")__REPLACE_END__ " + f
   end
 end
 var light = d.find("daylight_duration")
 if light != nil && size(light) > 0 && light[0] != nil
   var seconds = int(light[0])
   var hh = int(seconds / 3600)
   var mm = int((seconds % 3600) / 60)
   self.labels[12] = self.tr("DZIEN ","DAY ")__REPLACE_END__ " + str(hh) + "h " + str(mm) + "m"
 end
 var rise = d.find("sunrise")
 if rise != nil && size(rise) > 0
   var tm = self.clock_hm(rise[0])
   if tm != nil self.labels[21] = self.tr("WSCH SL ","SUNRISE ")__REPLACE_END__ " + tm end
 end
 var sunset_list = d.find("sunset")
 if sunset_list != nil && size(sunset_list) > 0
   var tm = self.clock_hm(sunset_list[0])
   if tm != nil self.labels[22] = self.tr("ZACH SL ","SUNSET ")__REPLACE_END__ " + tm end
 end
 var mr = d.find("moonrise")
 if mr != nil && size(mr) > 0
   var tm = self.clock_hm(mr[0])
   if tm != nil self.labels[23] = self.tr("WSCH KS ","MOONRISE ")__REPLACE_END__ " + tm end
 end
 var ms = d.find("moonset")
 if ms != nil && size(ms) > 0
   var tm = self.clock_hm(ms[0])
   if tm != nil self.labels[24] = self.tr("ZACH KS ","MOONSET ")__REPLACE_END__ " + tm end
 end
 var mins = d.find("temperature_2m_min")
 if mins != nil && size(mins) > 1 && mins[1] != nil
   self.labels[13] = self.tr(self.tr("PRZYM JUTRO ","FROST JUTRO ")__REPLACE_END__ JUTRO ","FROST TOMORROW ")__REPLACE_END__ " + self.n0(mins[1]) + "°C"
 end
  end
  def build_air()
 var a = self.air
 if a == nil return end
 var q = a.find("european_aqi")
 self.labels[8] = "EAQI " + self.n0(q)
 self.labels[9] = "PM2.5 " + self.n0(a.find("pm2_5")) + " ug/m3"
 self.labels[10] = "PM10 " + self.n0(a.find("pm10")) + " ug/m3"
 if q != nil
   if q <= 20
     self.colors[8] = 0x00DD66
   elif q <= 40
     self.colors[8] = 0x88DD00
   elif q <= 60
     self.colors[8] = 0xFFDD00
   elif q <= 80
     self.colors[8] = 0xFF8800
   elif q <= 100
     self.colors[8] = 0xFF3300
   else
     self.colors[8] = 0xBB44FF
   end
 end
  end
  def build_pollen()
 var a = self.pollen
 if a == nil return end
 self.labels[14] = self.tr("OLCHA ","ALDER ")__REPLACE_END__ " + self.n0(a.find("alder_pollen")) + " zi/m3"
 self.labels[15] = self.tr("BRZOZA ","BIRCH ")__REPLACE_END__ " + self.n0(a.find("birch_pollen")) + " zi/m3"
 self.labels[16] = self.tr("TRAWY ","GRASS ")__REPLACE_END__ " + self.n0(a.find("grass_pollen")) + " zi/m3"
 self.labels[17] = self.tr("BYLICA ","MUGWORT ")__REPLACE_END__ " + self.n0(a.find("mugwort_pollen")) + " zi/m3"
 self.labels[18] = self.tr("AMBROZJA ","RAGWEED ")__REPLACE_END__ " + self.n0(a.find("ragweed_pollen")) + " zi/m3"
  end
  def on_weather(body, status)
 if body != nil && status == 200
   try
     var d = json.load(body)
     if isinstance(d, map)
       var c = d.find("current")
       if isinstance(c, map)
         self.weather = c
         self.weather_at = now_ms()
         self.build_weather()
       end
       var daydata = d.find("daily")
       if isinstance(daydata, map)
         self.daily = daydata
         self.build_daily()
       end
     end
   except .. as err, msg
     log("Meteo: " + msg)
   end
 else
   log("Meteo HTTP: " + str(status))
 end
 http.get(self.aurl, / b, st -> self.on_air(b, st))
  end
  def on_air(body, status)
 if body != nil && status == 200
   try
     var d = json.load(body)
     if isinstance(d, map)
       var c = d.find("current")
       if isinstance(c, map)
         self.air = c
         self.air_at = now_ms()
         self.build_air()
       end
     end
   except .. as err, msg
     log("Air: " + msg)
   end
 else
   log("Air HTTP: " + str(status))
 end
 http.get(self.purl, / b, st -> self.on_pollen(b, st))
  end
  def on_pollen(body, status)
 self.busy = false
 if body == nil || status != 200
   self.pollen = nil
   return
 end
 try
   var d = json.load(body)
   if isinstance(d, map)
     var c = d.find("current")
     if isinstance(c, map)
       self.pollen = c
       self.pollen_at = now_ms()
       self.build_pollen()
     else
       self.pollen = nil
     end
   end
 except .. as err, msg
   self.pollen = nil
   log("Pylki: " + msg)
 end
  end
  def loop()
 if self.ticks <= 0 && !self.busy
   self.busy = true
   self.ticks = 600
   http.get(self.wurl, / b, st -> self.on_weather(b, st))
 end
 self.ticks -= 1
  end
  def duration()
 return 7000
  end
  def visible(i)
 if i == 0 || i == 1 || i == 3 return true end
 if i == 12
   if self.daily == nil return false end
   var x = self.daily.find("daylight_duration")
   return x != nil && size(x) > 0 && self.positive(x[0], 1)
 end
 if i == 13
   if self.daily == nil return false end
   var x = self.daily.find("temperature_2m_min")
   return x != nil && size(x) > 1 && x[1] != nil && x[1] <= 0
 end
 if i == 25 return self.phase != nil end
 if i >= 21 && i <= 24
   if self.daily == nil return false end
   var names = ["sunrise","sunset","moonrise","moonset"]
   var arr = self.daily.find(names[i - 21])
   return arr != nil && size(arr) > 0 && self.clock_hm(arr[0]) != nil
 end
 if i == 19 return self.is_snow() end
 if i == 20 return self.is_hail() end
 if i >= 14 && i <= 18
   if self.pollen == nil return false end
   var names = ["alder_pollen", "birch_pollen", "grass_pollen", "mugwort_pollen", "ragweed_pollen"]
   return self.positive(self.pollen.find(names[i - 14]), 0.5)
 end
 if i == 8 || i == 9 || i == 10
   if self.air == nil return false end
   var keys = ["european_aqi", "pm2_5", "pm10"]
   return self.positive(self.air.find(keys[i - 8]), 0.5)
 end
 if self.weather == nil return false end
 if i == 11
   return self.weather.find("soil_temperature_6cm") != nil
 end
 var names = ["temperature_2m", "apparent_temperature",
   "precipitation", "cloud_cover", "shortwave_radiation",
   "pressure_msl", "wind_speed_10m", "wind_gusts_10m"]
 if i >= 2 && i <= 7
   var v = self.weather.find(names[i])
   if i == 2
     return self.positive(v, 0.05) && !self.is_snow() && !self.is_hail()
   end
   return self.positive(v, 0.5)
 end
 return false
  end
  def ensure_visible()
 var n = 0
 while n < size(self.labels) && !self.visible(self.page)
   self.page = (self.page + 1) % size(self.labels)
   n += 1
 end
  end
  def next_page()
 self.page = (self.page + 1) % size(self.labels)
 self.ensure_visible()
 self.anim_start = now_ms()
  end
  def on_show()
 self.anim_start = now_ms()
  end
  def on_hide()
 self.next_page()
  end
  def on_button(btn)
 if btn == "select"
   self.next_page()
   return true
 end
 return false
  end
  def draw_glyph()
 var art = self.glyphs[self.page]
 var y = 0
 while y < 8
   var row = art[y]
   var x = 0
   while x < 8
     var ch = row[x]
     var c = 0
     if ch == self.tr("W","WIND")
       c = 0xFFFFFF
     elif ch == "T"
       c = self.page == 1 ? self.feels_fill : self.temp_fill
     elif ch == "B"
       c = 0x1268FF
     elif ch == "C"
       c = 0x44DDFF
     elif ch == self.tr("G","GUST")
       c = 0x36DD33
     elif ch == "Y"
       c = 0xFFFF27
     elif ch == "O"
       c = 0xFF9922
     elif ch == "R"
       c = 0xFF3333
     elif ch == "D"
       c = 0x8D5E23
     elif ch == "S"
       c = 0x999999
     end
     if c != 0
       pixel(x, y, c)
     end
     x += 1
   end
   y += 1
 end
  end
  def draw_event()
 var moon = self.page >= 23
 var rising = self.page == 21 || self.page == 23
 var frame = int((now_ms() - self.anim_start) / 600) % 4
 if !rising frame = 3 - frame end
 var cy = 7 - frame * 2
 var hor = moon ? 0x36A9DD : 0x36DD55
 var x = 0
 while x < 8
   pixel(x, 6, hor)
   pixel(x, 7, moon ? 0x11315F : 0x174D28)
   x += 1
 end
 if moon
   pixel(0, 1, 0xAFCFFF)
   pixel(7, 0, 0xEDF5FF)
 end
 var dy = -2
 while dy <= 2
   var dx = -2
   while dx <= 2
     var yy = cy + dy
     if dx*dx + dy*dy <= 5 && yy >= 0 && yy < 6
       var col = moon ? 0xE4EFFF : 0xFFCC20
       if moon
         if dx == -2 || dy == -2 col = 0x94BCEB end
       else
         if dx == -2 || dx == 2 col = 0xFF881B end
         if dx == -1 && dy == -1 col = 0xFFF9A3 end
       end
       pixel(3 + dx, yy, col)
     end
     dx += 1
   end
   dy += 1
 end
 if !moon && frame >= 2
   pixel(0, 2, 0xFFE326)
   pixel(7, 2, 0xFFE326)
 end
  end
  def draw_phase()
 var p = self.phase
 if p == nil return end
 pixel(0, 0, 0x9AB9D8)
 pixel(7, 2, 0x9AB9D8)
 var edge = p <= 0.5 ? 7 - int(p * 12 + 0.5) : 1 + int((p - 0.5) * 12 + 0.5)
 var y = 1
 while y <= 6
   var x = 1
   while x <= 6
     if !(y == 1 || y == 6) || (x >= 2 && x <= 5)
       var lit = p <= 0.5 ? x >= edge : x < edge
       var col = lit ? 0xF5F2DC : 0x2A3E5E
       if lit && x == 2 && y == 2 col = 0xFFFFFF end
       pixel(x, y, col)
     end
     x += 1
   end
   y += 1
 end
  end
  def draw()
 self.ensure_visible()
 clear()
 font("small")
 if self.page >= 21 && self.page <= 24
   self.draw_event()
 elif self.page == 25
   self.draw_phase()
 else
   self.draw_glyph()
 end
 scroll_text(9, 6, width() - 9,
   self.labels[self.page], self.colors[self.page], self.scroll_opts)
 var stamp = self.weather_at
 if self.page >= 8 && self.page <= 10
   stamp = self.air_at
 elif self.page >= 14 && self.page <= 18
   stamp = self.pollen_at
 end
 if stamp == 0 || now_ms() - stamp > 1800000
   pixel(31, 0, 0xFF0000)
 end
  end
end
return MeteoMatrix()